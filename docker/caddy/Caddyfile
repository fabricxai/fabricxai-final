# TLS termination for the single-factory deployment.
#
# Caddy is here for one reason that matters and one that is convenience: it gets and
# renews a Let's Encrypt certificate without anybody remembering to, and it is the only
# container with a published port. Everything else on this host talks over the compose
# network.

{
	email {$TLS_EMAIL}
	# Certificates and OCSP staples live in the caddy-data volume, so a container
	# rebuild does not mean a new certificate and a rate-limit problem.
}

{$APP_DOMAIN} {
	encode zstd gzip

	# ── Object storage ─────────────────────────────────────────────────────────
	#
	# Routed on the BUCKET path, with no prefix. This route exists because a floor tablet
	# cannot resolve `minio:9000`, which is what the server-side endpoint is (audit INFRA-H1).
	#
	# It used to be `handle_path /s3/*`, whose own comment said the prefix "must arrive at
	# MinIO intact… stripping it invalidates every signature" — while `handle_path` is
	# precisely the directive that strips it. Every upload and download returned
	# 403 SignatureDoesNotMatch.
	#
	# Not fixable by switching to `handle` either. SigV4 signs the path, so the path the
	# client signs has to be the path MinIO serves, and MinIO reads the FIRST path segment as
	# the bucket:
	#
	#   strip  /s3  →  signed /s3/bucket/key, served /bucket/key  →  403 SignatureDoesNotMatch
	#   keep   /s3  →  signed /s3/bucket/key, served /s3/bucket/key → 404, bucket "s3"
	#
	# So the prefix goes. `S3_PUBLIC_ENDPOINT` is now the bare origin, presigned URLs are
	# {$APP_DOMAIN}/{bucket}/{key}, and the bucket name becomes a reserved top-level path on
	# this domain — which is why it is matched explicitly rather than with a wildcard: only
	# that one path leaves the application.
	#
	# A dedicated `s3.` subdomain is the tidier long-term shape and needs a DNS record; this
	# needs none.
	handle /{$S3_BUCKET}/* {
		reverse_proxy minio:9000 {
			# Uploads are up to 25MB (core/documents.ts); do not buffer them in Caddy.
			flush_interval -1
		}
	}

	# ── The application ────────────────────────────────────────────────────────
	reverse_proxy app:3000 {
		# The app sets its own security headers in next.config.ts, deliberately, so
		# that a deployment which bypasses this proxy still ships them. Nothing is
		# added here — two sources for one header is how a CSP ends up doubled and
		# silently ignored by the browser.
		header_up X-Forwarded-Proto {scheme}

		# READINESS, which is a different question from liveness (plan 7.5).
		#
		# /api/ready checks Postgres and Redis through the pooled path a real request
		# takes, with a 2s deadline per dependency so it answers rather than hangs. If
		# the app cannot reach its database, Caddy stops sending traffic here and the
		# caller gets a 502 it can retry — instead of a 500 from a request that got
		# halfway in.
		#
		# NOT /api/health: that is liveness and answers 200 from a process that cannot
		# reach anything, which is correct for Docker and useless here. And not the
		# scheduler either — a quiet nightly job does not stop this instance serving a
		# merchandiser, and routing on it would take a working app out of rotation for
		# another process's problem.
		health_uri /api/ready
		health_interval 10s
		health_timeout 5s
		health_status 200
	}

	# A floor tablet posting a shift's worth of offline rows, plus a 25MB challan photo,
	# against a body limit that is generous but not unbounded (audit INFRA-M4: route
	# handlers have no ceiling of their own, only server actions do).
	request_body {
		max_size 30MB
	}

	log {
		output file /data/access.log {
			roll_size 20MB
			roll_keep 5
		}
		# The floor posts every hour of every shift; logging each one at INFO fills a
		# disk and hides the requests that matter.
		level WARN
	}
}
