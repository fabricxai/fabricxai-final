# ─────────────────────────────────────────────────────────────────────────────
# FabricXAI — environment. Copy to `.env` and fill in.
# Every key here is validated by Zod at boot (src/lib/env.ts) — the process
# refuses to start and lists everything that is missing or malformed.
# Defaults below match docker-compose.dev.yml, so a fresh clone boots as-is.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000

# ── Postgres ────────────────────────────────────────────────────────────────
# App traffic goes through PgBouncer (transaction mode) — Next.js route
# concurrency exhausts raw PG connections (dev-plan §1).
DATABASE_URL=postgres://fabricxai_app_rw:fabricxai-app-dev-secret@localhost:6432/fabricxai
# Migrations and drizzle-kit bypass the pooler: DDL, advisory locks and
# prepared statements do not survive transaction pooling.
DIRECT_DATABASE_URL=postgres://fabricxai:fabricxai@localhost:5433/fabricxai

# ── Redis (BullMQ, rate limits, cached aggregates) ──────────────────────────
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# ── Object storage (MinIO in dev; any S3 API in prod) ───────────────────────
S3_ENDPOINT=http://localhost:9000
# Browser-facing storage base, used only for signing presigned URLs. Unset in dev,
# where the browser and the server reach MinIO at the same address. In production it
# MUST be set (docker-compose.prod.yml sets it to ${APP_URL}/s3): the server reaches
# MinIO at http://minio:9000, which a floor tablet cannot resolve, and SigV4 signs the
# host so the URL cannot be corrected after the fact.
# S3_PUBLIC_ENDPOINT=https://erp.example.com/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=fabricxai
S3_SECRET_ACCESS_KEY=fabricxai-dev-secret
S3_BUCKET=fabricxai-documents
S3_FORCE_PATH_STYLE=true

# ── Model providers (required when NODE_ENV=production) ─────────────────────
# Routed by task type in the model registry (PLAYBOOK §6a) — never referenced
# directly from a module.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Serve MARBIM from fixtures instead of calling providers. Dev/test only.
MARBIM_MOCK=true

# ── Email ───────────────────────────────────────────────────────────────────
# Dev: Mailpit (SMTP on 1025, UI on http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@fabricxai.local
# Prod: transactional provider only, never self-hosted SMTP.
RESEND_API_KEY=

# ── Observability (required when NODE_ENV=production) ───────────────────────
SENTRY_DSN=
